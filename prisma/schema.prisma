generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum MembershipType {
  BASIC
  PREMIUM
}

enum MemberStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum GeneratedCodeCategory {
  ACTIVATION
  TOP_UP
  BENEFICIARY
}

enum ActivationCodeType {
  BASIC
  PREMIUM
}

enum GeneratedCodeStatus {
  AVAILABLE
  USED
  EXPIRED
  DISABLED
}

model Member {
  id           String @id @default(uuid()) @db.Char(36)
  membershipId String @unique @map("membership_id") @db.VarChar(30)

  firstName  String  @map("first_name") @db.VarChar(100)
  middleName String? @map("middle_name") @db.VarChar(100)
  lastName   String  @map("last_name") @db.VarChar(100)
  email      String? @unique @db.VarChar(191)
  phone      String  @db.VarChar(30)

  username       String         @unique @db.VarChar(50)
  passwordHash   String?        @map("password_hash") @db.VarChar(255)
  membershipType MembershipType @default(BASIC) @map("membership_type")
  status         MemberStatus   @default(PENDING_ACTIVATION)

  referralCode        String    @unique @map("referral_code") @db.VarChar(20)
  activationCodeHash  String?   @unique @map("activation_code_hash") @db.Char(64)
  activationExpiresAt DateTime? @map("activation_expires_at") @db.DateTime(3)

  sponsorId       String?       @map("sponsor_id") @db.Char(36)
  sponsor         Member?       @relation("MemberSponsor", fields: [sponsorId], references: [id], onDelete: Restrict)
  referredMembers Member[]      @relation("MemberSponsor")
  beneficiaries   Beneficiary[]

  redeemedGeneratedCodes GeneratedCode[] @relation("GeneratedCodeUsedByMember")

  // Only the first member receives the value "ROOT".
  // MySQL permits multiple NULL values in a unique column.
  rootMarker String? @unique @map("root_marker") @db.VarChar(10)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([sponsorId])
  @@index([status])
  @@map("members")
}

model Beneficiary {
  // Internal database identifier.
  id String @id @default(uuid()) @db.Char(36)

  // Public sub-ID, for example: LC-9NUV24B36SP9-B01.
  beneficiaryId String @unique @map("beneficiary_id") @db.VarChar(40)
  sequence      Int    @map("sequence_number")

  // Internal UUID of the primary member who owns this beneficiary.
  primaryMemberId String @map("primary_member_id") @db.Char(36)

  firstName    String  @map("first_name") @db.VarChar(100)
  middleName   String? @map("middle_name") @db.VarChar(100)
  lastName     String  @map("last_name") @db.VarChar(100)
  relationship String  @db.VarChar(50)
  address      String  @db.Text

  primaryMember Member @relation(fields: [primaryMemberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([primaryMemberId, sequence])
  @@index([primaryMemberId])
  @@map("beneficiaries")
}

model GeneratedCodeBatch {
  id String @id @default(uuid()) @db.Char(36)

  category       GeneratedCodeCategory
  activationType ActivationCodeType?   @map("activation_type")
  topUpAmount    Int?                  @map("top_up_amount") @db.UnsignedInt
  quantity       Int                   @db.UnsignedInt

  generatedAt          DateTime @default(now()) @map("generated_at") @db.DateTime(3)
  generatedByAdminId   String?  @map("generated_by_admin_id") @db.VarChar(191)
  generatedByAdminName String?  @map("generated_by_admin_name") @db.VarChar(191)

  codes GeneratedCode[]

  @@index([category])
  @@index([generatedAt])
  @@index([generatedByAdminId])
  @@map("generated_code_batches")
}

model GeneratedCode {
  id   String @id @default(uuid()) @db.Char(36)
  code String @unique @db.VarChar(32)

  category       GeneratedCodeCategory
  status         GeneratedCodeStatus   @default(AVAILABLE)
  activationType ActivationCodeType?   @map("activation_type")
  topUpAmount    Int?                  @map("top_up_amount") @db.UnsignedInt

  generatedAt          DateTime  @default(now()) @map("generated_at") @db.DateTime(3)
  generatedByAdminId   String?   @map("generated_by_admin_id") @db.VarChar(191)
  generatedByAdminName String?   @map("generated_by_admin_name") @db.VarChar(191)
  expiresAt            DateTime? @map("expires_at") @db.DateTime(3)

  usedAt           DateTime? @map("used_at") @db.DateTime(3)
  usedByMemberId   String?   @map("used_by_member_id") @db.Char(36)
  usedByMemberName String?   @map("used_by_member_name") @db.VarChar(300)

  disabledAt        DateTime? @map("disabled_at") @db.DateTime(3)
  disabledByAdminId String?   @map("disabled_by_admin_id") @db.VarChar(191)
  disabledReason    String?   @map("disabled_reason") @db.VarChar(500)

  generationBatchId String             @map("generation_batch_id") @db.Char(36)
  generationBatch   GeneratedCodeBatch @relation(fields: [generationBatchId], references: [id], onDelete: Restrict)

  usedByMember Member? @relation("GeneratedCodeUsedByMember", fields: [usedByMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([category, status])
  @@index([activationType, status])
  @@index([topUpAmount, status])
  @@index([generatedAt])
  @@index([expiresAt])
  @@index([usedByMemberId])
  @@index([generationBatchId])
  @@map("generated_codes")
}
